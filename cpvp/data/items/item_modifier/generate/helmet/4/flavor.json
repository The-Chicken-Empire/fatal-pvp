{
  "function": "minecraft:set_lore",
  "lore": [
    [
      {
        "text": "何故か私は生まれつき目がよくないんだよね。",
        "color": "dark_gray",
        "italic": true
      }],[
      {
        "text": "普段の生活はちょっと不便だけど、",
        "color": "dark_gray",
        "italic": true
      }],[
      {
        "text": "翼でつついたらどこに何があるかはわかるし、",
        "color": "dark_gray",
        "italic": true
      }],[
      {
        "text": "それに見えない誰かがどんな姿になろうが",
        "color": "dark_gray",
        "italic": true
      }
      
    ],[
      {
        "text": "心が痛まないから思い切って殺れるんだよね。",
        "color": "dark_gray",
        "italic": true
      }
      
    ]
  ],
  "mode": "append"
}
